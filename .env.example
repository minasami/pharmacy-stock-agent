# Copy to .env (never commit). Without a key the app runs on the deterministic mock provider.
MODEL_PROVIDER=mock        # mock | meta | baseten
MODEL_API_KEY=             # Meta Model API key (starts with LLM_)
META_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_AGENT_MODEL=muse-spark-1.3   # chooses the agent's next tool (tool calling)
META_TIMEOUT_MS=60000     # per-request timeout; 429/5xx are retried twice
# Backup: open-weights Muse Spark Open on Baseten Model APIs (MODEL_PROVIDER=baseten).
# Reads and the agent planner go to Baseten; SAM 3.1 stays Meta-only (used only if MODEL_API_KEY is set).
BASETEN_API_KEY=           # from your Baseten account; never commit
BASETEN_MODEL=meta-models/muse-spark-open-1026   # Baseten docs list meta-models/muse-spark-open
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_REASONING_EFFORT=  # optional: low | medium | high | xhigh (model default xhigh)
BASETEN_TIMEOUT_MS=120000
